# UpstageHandel CRM Web Environment Variables
# The CRM connects by default to the scaner-billing Firebase project.
# You can override these variables for custom staging or production environments.

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=scaner-billing.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=scaner-billing
VITE_FIREBASE_STORAGE_BUCKET=scaner-billing.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=207862672282
VITE_FIREBASE_APP_ID=1:207862672282:web:1d5d5529b31148ac1ae823

# Authorized Administrator Emails (Comma-separated)
VITE_ADMIN_EMAILS=admin@upstage.com,upstagepos@gmail.com
